{
  "hosting": {
    "site": "pose-lab-visual-truth",
    "public": "generated/firebase_hosting/pose_lab_release",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/generated/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.{js,mjs,css,json}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.{glb,fbx,png,jpg,jpeg,webp}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
